# Copy to `.env.local` (gitignored) and adjust for your MongoDB.
# The app uses database name `devflow` (see lib/mongoose.ts).
#
# Local MongoDB example:
# MONGO_DB_URL=mongodb://127.0.0.1:27017/devflow
#
# Atlas / remote example:
# MONGO_DB_URL=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?appName=kanban-clone
MONGO_DB_URL=
